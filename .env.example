# ==============================================================================
# LUXESTUDIO LEADFLOW CRM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database
# Production PostgreSQL Connection string (e.g., Neon, Supabase, or AWS RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/leadflow?schema=public"

# Application URL & Timezone
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# Authentication & Session Secrets
# Generate using: openssl rand -base64 32
SESSION_SECRET="your-32-character-secret-key-goes-here"
INVITE_SECRET="your-invite-token-secret-key-goes-here"

# Telegram Bot Integration
# 1. Create a bot via @BotFather on Telegram to obtain the bot token.
# 2. Enter bot username without the '@' prefix.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Webhook secret for securing incoming Telegram update callbacks
TELEGRAM_WEBHOOK_SECRET=""

# Transactional Email Provider (Amazon SES / SMTP)
EMAIL_PROVIDER="unconfigured" # Options: "ses", "smtp", "unconfigured"
EMAIL_FROM="LuxeStudio Notifications <notifications@theluxestudio.in>"
NOTIFICATION_EMAIL_TO="hello@theluxestudio.in"
NOTIFICATION_EMAIL_CC="rahulk19022@gmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Background Cron & Worker Security Key
# Header x-cron-key must match this value when invoking /api/cron
CRON_SECRET="generate-a-strong-cron-key"
